{
  "policy_name": "logihertz_hardened_tpm2_appliance",
  "sha1_pcr_bank_enabled": false,
  "active_pcr_hash_alg": "SHA256",
  "pcr0_bound": true,
  "pcr4_bound": true,
  "pcr7_bound": true,
  "owner_auth_configured": true,
  "endorsement_auth_configured": true,
  "lockout_auth_configured": true,
  "da_max_tries": 5,
  "da_recovery_time_sec": 1800,
  "da_lockout_recovery_sec": 7200,
  "parameter_encryption_aes_cfb": true,
  "salted_hmac_session_required": true,
  "srk_key_bits": 3072,
  "aik_restricted_signing": true,
  "quote_nonce_min_bytes": 32,
  "verify_ek_cert_chain": true,
  "nv_rollback_index_locked": true,
  "require_tpm_pin_with_pcr": true,
  "use_kernel_tpmrm0": true,
  "device_permissions_octal": 600,
  "verify_tcg_event_log_replay": true
}
